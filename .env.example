# ==============================================================================
# DevFolio - Configurações de Ambiente (Opcionais para Execução Local)
# ==============================================================================
# O DevFolio foi desenhado com arquitetura Local-First.
# Por padrão, o site funciona 100% local com dados estáticos e mídias de public/images.
#
# Se você deseja ativar o Supabase (banco de dados, autenticação e storage) ou
# o pipeline de IA (Gemini 2.0 Flash em /admin/intake), preencha as variáveis abaixo:

# Supabase (Opcional - caso queira persistência em nuvem e painel admin)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Google Gemini API Key (Opcional - caso queira usar a pipeline de Intake em /admin/intake)
GEMINI_API_KEY=your_gemini_api_key_here
